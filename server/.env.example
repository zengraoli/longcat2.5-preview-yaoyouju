# 服务端口
PORT=3400

# 业务库与身份隔离库（SQLite 文件路径）
DB_PATH=./data/app.db
IDENTITY_DB_PATH=./data/identity.db

# 字段加密密钥（AES-256-GCM，64 位十六进制 = 32 字节）。生产环境必须通过环境变量注入，不要提交真实值。
IDENTITY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 登录会话令牌签名密钥（演示用，生产环境请更换）
SESSION_SECRET=dev-only-session-secret-change-me

# 会话有效期（小时）
SESSION_TTL_HOURS=72

# 短信验证码（演示固定值）
SMS_CODE=123456

# 后台 TOTP 演示固定码
ADMIN_TOTP_CODE=123456

# 后台登录失败锁定（次 / 分钟）
ADMIN_LOCK_THRESHOLD=5
ADMIN_LOCK_MINUTES=15

# Worker 轮询间隔（毫秒）
WORKER_POLL_MS=1000
